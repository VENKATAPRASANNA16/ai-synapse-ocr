# ===================================
# FRONTEND CONFIGURATION
# ===================================
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_ENV=development

# ===================================
# BACKEND CONFIGURATION
# ===================================
NODE_ENV=development
PORT=8000
DEBUG=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-very-long-and-random
JWT_EXPIRE=30d

# ===================================
# DATABASE CONFIGURATION
# ===================================
# MongoDB Connection String
MONGO_USER=
MONGO_PASSWORD=
MONGODB_URI=mongodb://ai-synapse-mongo:27017/ai_synapse


# ===================================
# REDIS CONFIGURATION
# ===================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================================
# OCR SERVICES CONFIGURATION
# ===================================
# Tesseract OCR
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=eng

# Azure Computer Vision (Optional - for Azure OCR)
AZURE_COMPUTER_VISION_KEY=your-azure-key-here
AZURE_COMPUTER_VISION_ENDPOINT=https://your-region.api.cognitive.microsoft.com/

# Google Cloud Vision (Optional)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# ===================================
# AI/ML CONFIGURATION
# ===================================
# OpenAI API Key (Required for RAG/Query functionality)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# ===================================
# FILE UPLOAD CONFIGURATION
# ===================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png
UPLOAD_PATH=./uploads
MAX_FILES_PER_UPLOAD=10

# ===================================
# EMAIL CONFIGURATION (Optional)
# ===================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@aisynapse.com

# ===================================
# SECURITY
# ===================================
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# LOGGING
# ===================================
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ===================================
# PORTS (used in docker-compose)
# ===================================
FRONTEND_PORT=3000
BACKEND_PORT=8000
MONGODB_PORT=27017
REDIS_PORT=6379